using System;
using System.Diagnostics;
using System.IO;
using System.Text;
using System.Threading.Tasks;
using Encode.Models;

namespace Encode.Services
{
    /// <summary>
    /// Encapsulates YouTube download logic via yt-dlp and optional trimming via FFmpeg.
    /// </summary>
    public class DownloadService
    {
        private readonly string _appPath;
        private readonly Action<string> _log;

        public DownloadService(string applicationDirectory, Action<string> logCallback)
        {
            _appPath = applicationDirectory;
            _log = logCallback;
        }

        /// <summary>
        /// Processes a single download task (audio or video).
        /// </summary>
        public async Task<bool> ProcessDownloadTaskAsync(DownloadTask task)
        {
            try
            {
                if (task.OutputType == OutputType.Audio)
                    return await DownloadAudioAsync(task);
                else
                    return await DownloadVideoAsync(task);
            }
            catch (Exception ex)
            {
                _log($"Download error: {ex.Message}");
                return false;
            }
        }

        private async Task<bool> DownloadAudioAsync(DownloadTask task)
        {
            // Build audio download arguments
            string quality = $"{task.AudioBitrateKbps}K";
            string outputFile = task.OutputPath;

            // 1) Download full MP3
            bool ok = await RunProcessAsync(
                Path.Combine(_appPath, "yt-dlp.exe"),
                BuildAudioDownloadArgs(task, quality, outputFile)
            );
            if (!ok)
            {
                _log("Download failed.");
                return false;
            }

            // 2) Trim if needed
            if (task.Start.HasValue && task.End.HasValue)
            {
                string temp = Path.Combine(
                    Path.GetDirectoryName(outputFile)!,
                    Path.GetFileNameWithoutExtension(outputFile) + "_full.mp3"
                );

                var duration = task.End.Value - task.Start.Value;
                _log($"Starting trim: {task}");
                bool cutOk = await RunProcessAsync(
                    Path.Combine(_appPath, "ffmpeg.exe"),
                    $"-y -ss {task.Start:hh\\:mm\\:ss} -t {duration:hh\\:mm\\:ss} -i \"{temp}\" -c copy \"{outputFile}\""
                );
                try { File.Delete(temp); } catch { }

                if (!cutOk)
                {
                    _log("Trim failed.");
                    return false;
                }
            }

            return true;
        }

        private async Task<bool> DownloadVideoAsync(DownloadTask task)
        {
            string spec = task.Resolution switch
            {
                "480p" => "bestvideo[height<=480]+bestaudio",
                "720p" => "bestvideo[height<=720]+bestaudio",
                "1080p" => "bestvideo[height<=1080]+bestaudio",
                "4K" => "bestvideo[height<=2160]+bestaudio",
                _ => "bestvideo[height<=1080]+bestaudio"
            };

            // decide whether to include --no-playlist
            string playlistFlag = task.AllowPlaylist ? "" : "--no-playlist";

            string args;
            if (task.Start.HasValue && task.End.HasValue)
            {
                var dur = task.End.Value - task.Start.Value;
                args = $"-f \"{spec}\" {playlistFlag} -o - \"{task.Url}\" | " +
                       $"\"{Path.Combine(_appPath, "ffmpeg.exe")}\" " +
                       $"-ss {task.Start:hh\\:mm\\:ss} -i - -t {dur:hh\\:mm\\:ss} -c copy \"{task.OutputPath}\"";
            }
            else
            {
                args = $"-f \"{spec}\" {playlistFlag} -o \"{task.OutputPath}\" \"{task.Url}\"";
            }

            return await RunProcessAsync(
                Path.Combine(_appPath, "yt-dlp.exe"),
                args
            );
        }

        private string BuildAudioDownloadArgs(DownloadTask task, string quality, string outputFile)
        {
            // decide whether to include --no-playlist
            string playlistFlag = task.AllowPlaylist ? "" : "--no-playlist";

            if (task.Start.HasValue && task.End.HasValue)
            {
                return
                    $"-x {playlistFlag} --audio-format mp3 --audio-quality {quality} " +
                    $"-o \"{outputFile}\" \"{task.Url}\"";
            }
            else
            {
                return
                    $"{playlistFlag} -x --audio-format mp3 --audio-quality {quality} " +
                    $"-o \"{outputFile}\" \"{task.Url}\"";
            }
        }

        private async Task<bool> RunProcessAsync(string exePath, string arguments)
        {
            var psi = new ProcessStartInfo
            {
                FileName = exePath,
                Arguments = arguments,
                UseShellExecute = false,
                RedirectStandardOutput = true,
                RedirectStandardError = true,
                CreateNoWindow = true
            };

            var proc = new Process { StartInfo = psi, EnableRaisingEvents = true };
            var tcs = new TaskCompletionSource<bool>();

            proc.OutputDataReceived += (s, e) => { if (e.Data != null) _log(e.Data); };
            proc.ErrorDataReceived += (s, e) => { if (e.Data != null) _log(e.Data); };
            proc.Exited += (s, e) => tcs.TrySetResult(proc.ExitCode == 0);

            _log($"Starting process: {Path.GetFileName(exePath)} {arguments}");
            proc.Start();
            proc.BeginOutputReadLine();
            proc.BeginErrorReadLine();

            bool result = await tcs.Task;
            proc.Dispose();
            return result;
        }
    }
}
