<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>

    <RootNamespace>MediaFlux</RootNamespace>
    <AssemblyName>MediaFlux</AssemblyName>

    <ApplicationIcon>images\mediaflux_icn.ico</ApplicationIcon>
    <PackageIcon>mediaflux_icn.png</PackageIcon>
    <!-- Release builds override this once with the validated release tag value. -->
    <Version>0.1.92</Version>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Documentation\UserGuide.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="images\mediaflux_icn.ico" />
    <Content Include="gear-idle.png" Link="images\gear-idle.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="gear-wheel-animated.gif" Link="images\gear-wheel-animated.gif" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="folder-scan-animated.gif" Link="images\folder-scan-animated.gif" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="upscale-animated.gif" Link="images\upscale-animated.gif" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="compress128.png" Pack="True" PackagePath="\" />
    <None Update="images\mediaflux_icn.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.29" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <PackageReference Include="taglib-sharp-netstandard2.0" Version="2.1.0" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Helpers\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="MediaFlux.Tests\**\*.cs" />
    <None Remove="MediaFlux.Tests\**\*" />
  </ItemGroup>

</Project>
